ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional: needed to actually email password-reset codes. Until these are
# set, reset codes are printed to the server log (service.log) instead, so
# you can still test the flow yourself.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=you@gmail.com

# --- Security: set both of these before going live ---
# Comma-separated allowed origins for CORS. Defaults to "*" (wide open) if
# unset, which is fine for local dev but must be locked down for production,
# e.g.: ALLOWED_ORIGINS=chrome-extension://your-real-published-extension-id
ALLOWED_ORIGINS=

# DEV_MODE=true prints password-reset codes to the log when email can't be
# sent, so you can test locally without SMTP. Set to false in production —
# a leaked reset code in a real log is an account-takeover risk. It also
# gates the free-credit dev endpoint (/api/credits/purchase) — that route
# is disabled entirely whenever DEV_MODE is false.
DEV_MODE=true

# --- Stripe ---
# Test-mode keys are fine to start (sk_test_... / whsec_...). Get the
# secret key from Dashboard > Developers > API keys, and the webhook
# secret after creating the webhook endpoint (Dashboard > Developers >
# Webhooks > Add endpoint, pointing at <your-url>/api/stripe/webhook,
# listening for the checkout.session.completed event).
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
PUBLIC_BASE_URL=https://my-sales-assistant-backend.onrender.com
